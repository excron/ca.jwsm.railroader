/*
 * Charcoal — default theme for experiments.
 * Cool blue accents on charcoal panels.
 *
 * Palette values lifted from v0's _reference/ca.jwsm.railroader.ui/runtime/Themes/charcoal.json
 * (our own prior work — not vanilla's).
 *
 * Variables are scoped to the .theme-charcoal class. Apply on the root
 * VisualElement to activate; descendants inherit via the USS cascade.
 *
 * Theme-swap pattern (programmatic):
 *     root.RemoveFromClassList("theme-charcoal");
 *     root.AddToClassList("theme-someother");
 */

.theme-charcoal {
    --background:        rgba(26, 28, 31, 0.88);
    --panel:             rgba(34, 37, 42, 0.92);
    --panel-stripe:      rgba(52, 56, 63, 0.92);
    --titlebar-accent:   rgba(37, 43, 56, 0.92);
    --border:            #7A7E85;
    --text-primary:      #E8EAED;
    --text-muted:        #9AA0A6;
    --accent:            #4FC3F7;
    --accent-hover:      #81D4FA;
    --success:           #81C995;
    --warning:           #FDD663;
    --danger:            #F28B82;
}
