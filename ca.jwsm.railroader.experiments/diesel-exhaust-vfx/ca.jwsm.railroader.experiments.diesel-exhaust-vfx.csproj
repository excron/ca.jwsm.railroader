<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ca.jwsm.railroader.experiments.diesel-exhaust-vfx</AssemblyName>
    <RootNamespace>Ca.Jwsm.Railroader.Experiments.DieselExhaustVfx</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    Clean-room: this experiment swaps the VisualEffectAsset on diesel
    locomotives to a custom-authored VFX Graph (richer "clag" look).
    Bundle is authored externally in a Unity 2022.3 project and dropped
    into Assets/dieselexhaust.bundle by the BundleBuilder editor menu.
  -->

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.VFXModule">
      <HintPath>$(ManagedDir)\UnityEngine.VFXModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(UmmDir)\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(UmmDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="info.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Auto-deploy after build. Copies $(OutputPath) (which contains the DLL,
    PDB, info.json, and Assets/) into <GameDir>/Mods/<AssemblyName>/.
    GameDir resolves from Directory.Build.props (env var GAME_DIR or fallback).
  -->
  <Target Name="DeployMod" AfterTargets="Build">
    <PropertyGroup>
      <ModDeployDir>$(GameDir)\Mods\$(AssemblyName)</ModDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="@(DeployFiles)"
          DestinationFolder="$(ModDeployDir)\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Message Text="Deployed $(AssemblyName) -&gt; $(ModDeployDir)" Importance="high" />
  </Target>

</Project>
